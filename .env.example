# =====================================================================
# Required — Supabase
# =====================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only mirrors (used by SSR + server functions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin of the deployment. Used to build OAuth redirect URLs, so a
# wrong value silently breaks integration sign-in. Defaults to
# http://localhost:3000 when unset, which is wrong in production.
PUBLIC_APP_URL=https://your-domain

# =====================================================================
# Optional — AI (OpenRouter)
# Without this, AI features are disabled and the rest of the app works.
# Workspace owners can alternatively paste their own key in Settings → AI,
# which is stored per-workspace in the workspace_ai_secrets table and takes
# precedence over this env var where supported.
# =====================================================================
OPENROUTER_API_KEY=

# =====================================================================
# Optional — Google Calendar integration
# All three are needed together. Without them the calendar routes return 500
# rather than degrading quietly, so leave them unset unless you use it.
# The cron endpoint is guarded by CRON_SECRET and expects either
# `Authorization: Bearer <CRON_SECRET>` or `?token=<CRON_SECRET>`; generate a
# long random value and use the same one in whatever schedules the call.
# =====================================================================
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CRON_SECRET=

# =====================================================================
# Optional — White-label / branding
# Leave empty to use the upstream defaults.
# =====================================================================
VITE_BRAND_APP_NAME=
VITE_BRAND_SHORT_NAME=
VITE_BRAND_TAGLINE=
VITE_BRAND_DESCRIPTION=
VITE_BRAND_MARKETING_URL=
VITE_BRAND_SUPPORT_EMAIL=
VITE_BRAND_GITHUB_URL=
# Set to "true" to hide marketing routes (/, /features, /pricing) entirely
VITE_BRAND_HIDE_MARKETING=
# Set to "true" to hide footer "Built with…" attribution
VITE_BRAND_HIDE_ATTRIBUTION=
